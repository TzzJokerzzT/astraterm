# Maintainer: AstraTerm maintainers <maintainers@astraterm.invalid>
#
# Arch Linux PKGBUILD for AstraTerm.
#
# The `source` line points at the release tarball that makepkg --allsource
# produces from this repository.
#
# `sha256sums=('SKIP')` is deliberate, not an oversight that a release forgot:
# this PKGBUILD travels inside the tarball it would have to authenticate, so a
# real hash here would have to contain itself. If you need a verified build,
# publish the PKGBUILD as a separate artifact or verify the tag out of band
# (`git verify-tag v$pkgver`), which is what the release actually depends on.

pkgname=astraterm
pkgver=1.1.4
pkgrel=1
pkgdesc="Fast native terminal emulator with a built-in tab and split multiplexer"
arch=('x86_64' 'aarch64')
url="https://example.invalid/astraterm"
license=('MIT')
# Runtime libraries used by winit (Wayland/X11) and the wgpu/glyphon stack.
# `mesa` provides the OpenGL/Vulkan driver used by wgpu on most systems; users of
# a vendor Vulkan driver can satisfy that role with `vulkan-driver` instead.
# The X11 backend of winit additionally loads libX11 at runtime.
depends=('wayland' 'libxkbcommon' 'fontconfig' 'freetype2' 'mesa' 'libx11')
makedepends=('cargo' 'rust')
# The system-wide default configuration. Users' own configuration lives in
# ~/.config/astraterm/config.toml and is never packaged.
backup=('etc/astraterm/config.toml')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$pkgname-$pkgver"

    install -Dm755 target/release/astraterm "$pkgdir/usr/bin/astraterm"
    install -Dm644 packaging/desktop/astraterm.desktop \
        "$pkgdir/usr/share/applications/astraterm.desktop"
    install -Dm644 packaging/linux/config.toml "$pkgdir/etc/astraterm/config.toml"

    # The icon set is committed under assets/icons/hicolor (generated from
    # assets/icons/logo.png by assets/icons/generate-icons.sh), so the package
    # installs every size the icon theme asks for instead of scaling one bitmap.
    for size in 32x32 48x48 64x64 128x128 256x256 512x512; do
        install -Dm644 "assets/icons/hicolor/$size/apps/astraterm.png" \
            "$pkgdir/usr/share/icons/hicolor/$size/apps/astraterm.png"
    done
}
